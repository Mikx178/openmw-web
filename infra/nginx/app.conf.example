# SPDX-License-Identifier: GPL-3.0-or-later
# The second (dynamic) site. nginx terminates TLS and reverse-proxies to your backend
# running locally (systemd service or container) on 127.0.0.1:3000. EDIT server_name +
# upstream port for your app. Copy to app.conf and deploy alongside openmw-wasm.conf.
#
# NOTE: do NOT add the Cross-Origin-Embedder-Policy header here unless this app also needs
# SharedArrayBuffer — require-corp will block ordinary third-party embeds/scripts.

upstream app_backend {
    server 127.0.0.1:3000;   # <-- your backend's local port
    keepalive 16;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.example.com;   # <-- your app domain

    ssl_certificate     /etc/ssl/openmw/origin.crt;
    ssl_certificate_key /etc/ssl/openmw/origin.key;

    # Static assets straight from disk if you have any; everything else proxied.
    location / {
        proxy_pass         http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;      # already the real client IP (realip module)
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   Upgrade           $http_upgrade;     # websockets
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 300s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;   # <-- your app domain
    return 301 https://$host$request_uri;
}
