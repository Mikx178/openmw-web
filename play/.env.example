# Copy to play/.env to enable the data-chooser launcher page.
# When set, the site root ("/") serves launcher.html — where visitors pick between the
# bundled OpenMW sample game and their own local Morrowind files — instead of dropping
# straight into the game. Unset/0/false = current behavior (root boots the game).
OPENMW_LAUNCHER=1

# Override the dev-server port (default 8795).
# PORT=8795
